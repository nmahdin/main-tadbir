# Tadbir shared hosting / production. Copy to .env ONLY for a new installation.
# On an existing installation, merge settings privately; preserve its APP_KEY and DB credentials.
# Blank secrets MUST be filled on the server. Never commit the real .env.
APP_NAME="Tadbir"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-tadbir.morvarid-daron.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Copy these values from your hosting database panel, including any account prefix.
# DB_HOST is server-side, not a browser/API URL. Change it if your host requires another address.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# One server; no Redis, Cron or Laravel queue worker is assumed.
# storage/framework/{sessions,cache,views} and bootstrap/cache must be privately writable.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=tadbir_session
SESSION_PATH=/
SESSION_DOMAIN=.morvarid-daron.ir
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=tadbir.morvarid-daron.ir,api-tadbir.morvarid-daron.ir
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

AUTH_REGISTRATION_STATUS=pending
AUTH_REGISTRATION_ROLE=team_member
AUTH_REGISTRATION_AUTO_LOGIN=false

# Configure real SMTP details before using email/password recovery.
# Port 587 with smtp normally negotiates STARTTLS; use your provider's required settings.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tadbir"

# Three initial users. Set distinct passwords privately before the FIRST seed.
# Required: at least 12 characters, at most 72 bytes. Quote values containing # or spaces.
# There is deliberately no public/default password. Existing accounts are not overwritten.
SEED_MAHDI_PASSWORD=
SEED_EMAD_PASSWORD=
SEED_AMIRALI_PASSWORD=
# Optional real addresses; blank uses reserved, non-deliverable @users.invalid addresses.
SEED_MAHDI_EMAIL=
SEED_EMAD_EMAIL=
SEED_AMIRALI_EMAIL=
# After changing .env on a machine with CLI: php artisan config:clear
# Seed only after migrations and private password setup: php artisan db:seed
# Remove SEED_*_PASSWORD values after the first successful seed.

BALE_PANEL_URL=https://tadbir.morvarid-daron.ir/
BALE_PUBLIC_BASE_URL=https://api-tadbir.morvarid-daron.ir
# Optional external processing; empty keeps it disabled. Not the bot token.
BALE_RUNNER_SECRET=
# Configure the Bale bot token through the protected admin settings, not frontend/VITE variables.
