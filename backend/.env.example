# Production/shared-host profile sample for the Tadbir API. Contains NO secrets:
# every credential is intentionally left empty and must be filled on the host.
# Copy to .env only when the host has no .env yet, then merge - never replace an existing file.
APP_NAME="Tadbir"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-tadbir.morvarid-daron.ir
FRONTEND_URL=https://tadbir.morvarid-daron.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=tadbir_session
SESSION_PATH=/
SESSION_DOMAIN=.morvarid-daron.ir
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=tadbir.morvarid-daron.ir,api-tadbir.morvarid-daron.ir

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

AUTH_REGISTRATION_STATUS=pending
AUTH_REGISTRATION_ROLE=team_member
AUTH_REGISTRATION_AUTO_LOGIN=false

# Account email is retired; framework mail delivery stays disabled.
MAIL_MAILER=array

# Seed passwords are only used by `php artisan migrate --seed` on a fresh install.
SEED_MAHDI_PASSWORD=
SEED_EMAD_PASSWORD=
SEED_AMIRALI_PASSWORD=

# Bale bot: the panel is the Mini App entry point, the API base is used to
# register the webhook capability. The runner secret protects the tick endpoint
# used by an external scheduler on hosts without SSH/cron.
BALE_PANEL_URL=https://tadbir.morvarid-daron.ir/
BALE_PUBLIC_BASE_URL=https://api-tadbir.morvarid-daron.ir
BALE_RUNNER_SECRET=
