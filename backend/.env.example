APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# دامنه‌هایی که درخواست‌هایشان به‌صورت نشست‌محور (Sanctum SPA) پذیرفته می‌شود
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# در هاست اشتراکی با HTTPS این مقدار را true بگذارید
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# وضعیت و نقش حساب‌های ساخته‌شده از فرم ثبت‌نام (active برای فعال‌سازی خودکار)
AUTH_REGISTRATION_STATUS=pending
AUTH_REGISTRATION_ROLE=team_member
AUTH_REGISTRATION_AUTO_LOGIN=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bale: optional HTTPS scheduler. Use a NEW random secret of at least 32 characters.
# Empty = external runner disabled; no cron/worker is assumed.
BALE_RUNNER_SECRET=
BALE_PANEL_URL=https://tadbir.morvarid-daron.ir/
# Optional public backend base URL for displaying the webhook address (HTTPS, no /api/v1 suffix).
# Empty uses APP_URL. This does not enable webhook ingestion.
BALE_PUBLIC_BASE_URL=

# REQUIRED for new accounts: fill all three passwords in the real .env next to artisan, not only this example.
# Use distinct private passwords (12+ characters, <=72 bytes); there is no default password.
# After editing .env, run locally: php artisan config:clear && php artisan db:seed
# Existing accounts/passwords are never overwritten by a reseed. Remove these secrets after setup.
SEED_MAHDI_PASSWORD=
SEED_EMAD_PASSWORD=
SEED_AMIRALI_PASSWORD=
# Optional real addresses. Defaults are reserved, non-deliverable @users.invalid placeholders.
# SEED_MAHDI_EMAIL=
# SEED_EMAD_EMAIL=
# SEED_AMIRALI_EMAIL=
