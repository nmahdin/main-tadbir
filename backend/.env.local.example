# Local Windows/Linux development with SQLite. NEVER use this profile on the public host.
# Copy to .env only if there is no existing .env; preserve existing keys and data.
APP_NAME="Tadbir Local"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=sqlite
# Leave DB_DATABASE unset to use backend/database/database.sqlite automatically.
# For an existing SQLite DB, set its absolute path privately; do not replace/delete it.
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=tadbir_local_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

AUTH_REGISTRATION_STATUS=pending
AUTH_REGISTRATION_ROLE=team_member
AUTH_REGISTRATION_AUTO_LOGIN=false

# Local-only: mail is kept in memory, NOT delivered or written with reset tokens to logs.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=noreply@users.invalid
MAIL_FROM_NAME="Tadbir Local"

# Required for new accounts; no shared or fixed password is provided.
SEED_MAHDI_PASSWORD=
SEED_EMAD_PASSWORD=
SEED_AMIRALI_PASSWORD=
SEED_MAHDI_EMAIL=
SEED_EMAD_EMAIL=
SEED_AMIRALI_EMAIL=

BALE_PANEL_URL=http://localhost:3000/
# Real webhook delivery cannot reach localhost. Leave disabled for ordinary local development.
BALE_PUBLIC_BASE_URL=
BALE_RUNNER_SECRET=
