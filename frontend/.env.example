# Laravel API base URL. For local development, for example:
# VITE_API_URL="http://localhost:8000/api/v1"
VITE_API_URL="/api/v1"

# Laravel Sanctum application URL. Leave empty until Sanctum/session auth is enabled.
# VITE_SANCTUM_URL="http://localhost:8000"
VITE_SANCTUM_URL=""

# Laravel dev server used by the Vite proxy.
VITE_BACKEND_URL="http://127.0.0.1:8000"

# Explicit, read-only demonstration. Never enabled by API failure.
VITE_DEMO_MODE=false
